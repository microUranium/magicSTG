        "face_left": "res://assets/gfx/sprites/felis_face_4.png",
        "face_right": "res://assets/gfx/sprites/harpy_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "（こいつ、いざというときは絶対囮に使ってやる…。）"
