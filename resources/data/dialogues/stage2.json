      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "囲まれたらやばい…振り切らないと…！"
