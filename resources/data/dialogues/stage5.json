        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": "res://assets/gfx/sprites/harpy_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "（でも、こいつの言う通り、おかしくなってたのかな。あたし。）"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": "res://assets/gfx/sprites/harpy_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "（こんな場所をあの子の家と思い込んで…。あの子は一体…。）"
      }
