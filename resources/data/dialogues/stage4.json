        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "この辺の人なのかな…"
      },
      {
        "speaker_name": "",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
