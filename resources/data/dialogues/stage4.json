    "progression2": [
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "…？あそこに座ってるのは…。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_3.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "♪～～♪～～"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_3.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "やっぱり、あの子が歌ってたんだ！"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "あら？こんなところに人が来るなんて、珍しいわ。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "ごきげんよう。私はアリシア。あなたは…冒険者さんかしら？"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "え、まあそんなところかな。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "もしかしてこの辺に住んでる人？"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "ええ。ここから少し進んだところに私のお家があるの。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "良かった…！"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "あたし、火山に向かってるんだけど、どっちに進めば良いか分かるかな？"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "道に迷っちゃって…。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "うふふ。ここは霧が濃いものね。迷うのも仕方がないわ。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "ここは火山の麓よ。山頂を目指しているのならこの沼地を抜けるまで案内できるわ。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "本当！？助かった…！"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "……！お姉さん、後ろ！"
      }
    ],
    "battle_conversation": [
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_3.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "うわ！"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_3.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "この沼地って、こんなキモい魔物しか出てこないの？"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_3.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "あれはこの場所を住処にしている大蜘蛛よ。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_3.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "珍しいわ。いつもは人前に姿を現さないものなのに…。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "最近この島に魔族が入り込んで、その影響で魔物たちが凶暴化してるんだよ。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "アリシアは下がってて。あたしが追い払うから。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "ええ、怪我をしないようにね。お姉さん！"
      }
    ],
    "resolution": [
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "……多分もう大丈夫だよ。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "ありがとう、お姉さん！"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "お姉さん、お名前を教えてくれるかしら？"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "ん？あたしはフェリス・シィルベスト。\nシィルって呼んで。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "シィルお姉さん、あなたとっても強いのね！"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "そのネコちゃんたちもあなたの仲間？とっても素敵だわ！"
      },
      {
        "speaker_name": "精霊",
        "face_left": "res://assets/gfx/sprites/faily_full_body.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "……！(シャーッ！)"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/faily_full_body.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "あら、嫌われちゃったかしら？"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_3.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "あれ？普段は人によく懐く方なんだけどな…。なんかごめんね。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_3.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "私は動物にはあまり好かれないみたいなの。だから平気よ。"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_3.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "そうだ！もう暗くなるし、私のお家に案内してあげる！"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "え？いいの？"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_1.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "夜は危険な魔物もいっぱい出てきて危険なのよ？"
      },
      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "それにさっきのお礼もさせて欲しいわ。どうかしら？"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "それじゃあちょっとついていこうかな。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "（よくできた子だなあ。あたしが子どもの頃とは大違い。）"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_2.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "（でも丁度良かった。最近しっかり寝られてなかったし、お邪魔させてもらおう。）"
      }
    ]
  },
  "s4d12": {
    "intro": [
      {
