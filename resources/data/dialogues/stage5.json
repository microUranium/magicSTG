        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": "res://assets/gfx/sprites/harpy_face_0.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "あぁ、シィルにとっては豪邸だったかしら？"
