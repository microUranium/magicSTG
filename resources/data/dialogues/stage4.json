        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "なんかジメジメしてるし、霧が深いし…。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "さっさとこんな不気味な場所抜けてやる…。"
      }
