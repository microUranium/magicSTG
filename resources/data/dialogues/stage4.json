      {
        "speaker_name": "少女",
        "face_left": "res://assets/gfx/sprites/felis_face_2.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "right",
        "box_direction": "right",
        "text": "空飛ぶほうきの魔法使いって、絵本の世界みたいでなんだか素敵！"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_3.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "え？あ、まあ確かに珍しい…かも？"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": "res://assets/gfx/sprites/gothic_girl_face_0.png",
        "speaker_side": "left",
        "box_direction": "left",
        "text": "……。"
