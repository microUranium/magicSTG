{
  "s2d11": {
    "intro": [
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "あのハーピーが言うにはこの海岸の先に遺跡があって、"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "そこに手がかりを握ってる人がいるらしいけど…。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "「この島のことならなんでも知ってる情報屋」ねぇ…。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "そんなやつがいるならあたしたちの仕事も苦労しないっつーの。"
      }
    ],
    "progression": [
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "それにしても、ここの海っていつ見ても赤いなあ。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "この近辺に生息してる特殊な微生物の影響で赤く見える、とかなんとか。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "毎年ここは海水浴のスポットになってるけど、そう考えるとちょっと気持ち悪いかも…。"
      }
    ],
    "battle_conversation": [
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "あれは…鉱石エイ？"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "普段海底にいるやつがなんで浜に…？"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "なんかこっち見てきてない…？ヤバいかも！"
      }
    ],
    "resolution": [
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "鉱石エイ、こいつは本来大人しい魔物って聞いたなんだけどな…。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "そういえば魔物たちが凶暴化してるってハーピーも言ってたし。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_0.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "あの魔族を止めないことにはずっとこんな調子なのかな…。"
      },
      {
        "speaker_name": "フェリス",
        "face_left": "res://assets/gfx/sprites/felis_face_1.png",
        "face_right": null,
        "speaker_side": "left",
        "box_direction": "left",
        "text": "人手が足りないからってそんな大役をあたし一人に任せるなよ…。"
      }
    ]
  },
  "s2d12": {
